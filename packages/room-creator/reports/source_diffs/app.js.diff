 async function readImage(file){if(!['image/png','image/jpeg','image/webp'].includes(file.type))throw Error('Use individual PNG, JPEG or WebP images. Unzip asset packs before importing.');if(file.size>20*1024*1024)throw Error('Each image must be at most 20 MB.');const src=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(Error('Cannot read '+file.name));reader.readAsDataURL(file);});const image=await new Promise((resolve,reject)=>{const im=new Image();im.onload=()=>resolve(im);im.onerror=()=>reject(Error('Cannot decode '+file.name));im.src=src;});if(image.width>8192||image.height>8192)throw Error('Image dimensions must be at most 8192 × 8192.');return {asset:{id:C.uid('asset'),name:file.name.replace(/\.[^.]+$/,'').slice(0,180),src,width:image.width,height:image.height,category:'imported',view:'both'},image};}
 async function importImages(files,dropPoint=null){if(mode==='test')return;const token=operation,count=files.length;try{if(catalog.size+count>500)throw Error('The library supports up to 500 images.');const decoded=[];for(const file of [...files])decoded.push(await readImage(file));if(token!==operation)throw Error('The project changed during import. Please import again.');let total=[...catalog.values()].reduce((sum,a)=>sum+a.src.length,0)+decoded.reduce((sum,a)=>sum+a.asset.src.length,0);if(total>125*1024*1024)throw Error('The embedded library would exceed 125 MB.');if(mutate(()=>{for(const {asset,image}of decoded){catalog.set(asset.id,asset);R.images.set(asset.id,image);}pane='assets';},'Import images')){toast(decoded.length+' image(s) imported. Click an image, then place it on a visible floor point.');if(dropPoint&&decoded.length===1)placeAsset(decoded[0].asset.id,dropPoint);}}catch(e){toast('Import stopped: '+e.message,8000);}finally{$('assetFiles').value='';}}
 
